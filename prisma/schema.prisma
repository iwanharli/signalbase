generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Panel account. role "admin" manages everything; role "user" signs up, waits for an admin to approve,
// then manages only their own API keys.
model Admin {
  id            String    @id @default(uuid())
  username      String    @unique
  name          String
  passwordHash  String
  role          String    @default("admin") // "admin" | "user"
  status        String    @default("active") // "pending" (signed up, waiting for an admin) | "active" | "suspended"
  /// Plan of a "user" account: trial | starter | pro | instansi. null = no plan limits (accounts set up by hand).
  plan          String?
  /// End of the trial or paid period; keys stop working after it. null = no end date.
  planExpiresAt DateTime?
  /// Plan chosen on /pricing when signing up (?plan=), shown to the admin who approves; it does not grant anything.
  requestedPlan String?
  invoices      Invoice[]
  createdAt     DateTime  @default(now())
}

model ApiKey {
  id             String    @id @default(uuid())
  name           String
  prefix         String
  hash           String    @unique
  keyEnc         String? // the full key, AES-256-GCM (lib/server/secrets.ts), so admins can copy it later; null for keys made before this
  keywords       String[]  @default([]) // empty = whole bank; else items must mention one
  scope          Json      @default("{}") // other fixed restrictions, see lib/media/keyScope.ts
  ownerId        String? // account that owns the key (role user); null = managed by admins
  createdBy      String? // admin username; null for keys made before this was recorded
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  showAuthors    Boolean   @default(false) // unused: author details are now always returned
  allowedIps     String[]  @default([]) // empty = any IP; else "1.2.3.4", "1.2.3.0/24" or IPv6 (lib/keyAccess.ts)
  allowedOrigins String[]  @default([]) // empty = any site; else "app.example.id" or "*.example.id" (browser calls)

  classifier      Classifier?
  classifications Classification[]
  usage           ApiKeyUsage[]
  balances        BalanceSnapshot[]
  tokenUsage      TokenUsage[]
}

// AI categorisation settings and progress for one API key.
model Classifier {
  apiKeyId         String    @id
  apiKey           ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  // The AI service this key uses, with its own credentials.
  providerKind     String // "anthropic" | "openai_compatible"
  providerBaseUrl  String? // openai_compatible only, e.g. https://api.deepseek.com
  providerModel    String
  providerKeyEnc   String // AES-256-GCM, see lib/server/secrets.ts
  providerKeyHint  String // last 4 characters, for display only
  // Optional fallback, used for a batch only when the main provider fails (5xx, empty reply, timeout).
  fallbackKind     String?
  fallbackBaseUrl  String?
  fallbackModel    String?
  fallbackKeyEnc   String?
  fallbackKeyHint  String?
  enabled          Boolean   @default(true)
  prompt           String
  categories       Json // [{ code, label, description }]
  onlineCategories Json? // online news' own categories; null = same as `categories`
  minBalance       Float?    @default(1) // pause when provider credit drops below this; null = no floor
  dailyBudget      Float? // pause once today's spend reaches this; null = no cap
  // Item counts for the key's whole scope ({ social, online, at }); counting takes ~25 s, so it is kept here.
  scopeCounts      Json?
  labelledOnly     Boolean   @default(false) // API returns only items the AI has labelled
  startFrom        DateTime? // oldest publish time to label; null = the whole scope. Newer items are always labelled.
  // Progress per media type: { social: { newest, oldest, done }, online: {...} } (ISO timestamps)
  cursors          Json      @default("{}")
  processed        Int       @default(0)
  failed           Int       @default(0)
  todayCount       Int       @default(0)
  todayDate        String    @default("")
  lastError        String?
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// One item's category for one API key.
model Classification {
  apiKeyId    String
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  type        String // "social" | "online"
  code        String // item code in the source database
  category    String // a category code, or "none"
  confidence  Float?
  reason      String?
  publishedAt DateTime
  model       String
  manual      Boolean  @default(false) // set by an admin; the worker never overwrites it
  correctedBy String?
  createdAt   DateTime @default(now())

  @@id([apiKeyId, type, code])
  @@index([apiKeyId, type, category, publishedAt])
}

// Provider credit over time, recorded by the worker and on manual refresh; spend = drops between snapshots.
model BalanceSnapshot {
  id       Int      @id @default(autoincrement())
  apiKeyId String
  apiKey   ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  currency String
  total    Float
  at       DateTime @default(now())

  @@index([apiKeyId, at])
}

// Tokens the AI provider billed per key, hour, and model; works for every provider (no balance API needed).
model TokenUsage {
  apiKeyId     String
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  hour         DateTime // start of the hour (UTC)
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  calls        Int      @default(0)

  @@id([apiKeyId, hour, model])
}

// Public API calls per key per day (Jakarta date). Summed over an account's keys for its daily plan limit.
model ApiKeyUsage {
  apiKeyId String
  day      String // YYYY-MM-DD, Asia/Jakarta
  count    Int    @default(0)
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, day])
  @@index([day])
}

// Sales enquiries from the public /kontak page (e.g. the Instansi plan's "Hubungi kami").
model ContactRequest {
  id           String   @id @default(uuid())
  name         String
  organization String
  email        String
  phone        String?
  plan         String? // plan the visitor came from, e.g. "instansi"
  message      String
  handled      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([handled, createdAt])
}

// Manual billing: an invoice for one plan period. Marking it paid sets the account's plan and end date.
model Invoice {
  id          String    @id @default(uuid())
  number      String    @unique // SB-2026-0001
  accountId   String
  account     Admin     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind        String    @default("plan") // plan | topup (extra Signalbase AI posts for one month)
  plan        String // starter | pro | instansi (for a top-up: the plan it was bought on)
  billing     String // monthly | yearly (top-up: monthly)
  topupPosts  Int? // top-up only: posts added to that month's Signalbase AI quota
  subtotal    Int // rupiah, before tax
  tax         Int // rupiah
  total       Int
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("unpaid") // unpaid | paid | cancelled
  dueAt       DateTime
  paidAt      DateTime?
  note        String?
  createdBy   String // username of whoever created it (the user or an admin)
  createdAt   DateTime  @default(now())

  @@index([accountId, createdAt])
  @@index([status, createdAt])
}

// Extra Signalbase AI posts bought for one month (paid top-up invoices), on top of the plan's monthly quota.
model AiCredit {
  accountId String
  month     String // YYYY-MM, Asia/Jakarta
  posts     Int    @default(0)

  @@id([accountId, month])
}

// Platform AI settings (one row, id "global"): the provider behind Ringkasan AI, its schedule, and token prices for cost tracking.
model AiSetting {
  id               String   @id @default("global")
  providerKind     String   @default("openai_compatible") // "anthropic" | "openai_compatible"
  providerBaseUrl  String?
  providerModel    String
  providerKeyEnc   String // AES-256-GCM, see lib/server/secrets.ts
  providerKeyHint  String // last 4 characters, for display only
  summaryEnabled   Boolean  @default(true)
  summaryHour      Int      @default(6) // Jakarta hour the daily summaries are written
  includeProjects  Boolean  @default(true) // also one summary per active project, not only the whole bank
  monthlyBudget    Float? // stop writing summaries once this month's cost reaches this; null = no cap
  // Prices per 1M tokens, used to estimate each call's cost.
  priceInput       Float    @default(0.3)
  priceCachedInput Float    @default(0.006)
  priceOutput      Float    @default(1.2)
  currency         String   @default("USD")
  updatedBy        String?
  updatedAt        DateTime @updatedAt
}

// One AI summary of one scope ("bank" or an API key id) for one complete Jakarta data day (written the morning after).
model AiSummary {
  id        String   @id @default(uuid())
  scope     String // "bank" | ApiKey.id
  scopeName String // name when written, so history stays readable after a project is removed
  day       String // data day YYYY-MM-DD, Asia/Jakarta (normally yesterday when written)
  status    String // "ok" | "failed"
  content   Json? // SummaryContent (lib/ai/summary.ts)
  error     String?
  model     String
  attempts  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, day])
  @@index([day])
}

// Every call to the platform AI provider, with tokens and estimated cost: the cost history on the AI settings page.
model AiUsageLog {
  id           Int      @id @default(autoincrement())
  at           DateTime @default(now())
  purpose      String // "summary" | "test"
  scope        String?
  scopeName    String?
  model        String
  inputTokens  Int      @default(0)
  cachedTokens Int      @default(0) // part of inputTokens served from the provider's cache
  outputTokens Int      @default(0)
  cost         Float    @default(0)
  currency     String
  ok           Boolean
  error        String?
  ms           Int      @default(0)

  @@index([at])
}

// Executive report snapshot of one scope ("bank" or an API key id) for one complete period, written by the worker once the
// period is over: harian (one Jakarta day), mingguan (Monday-Sunday) or bulanan (a calendar month). `data` is the ReportData
// the print page renders; `cover` holds the few numbers the archive cards show.
model ArchivedReport {
  id        String   @id @default(uuid())
  scope     String // "bank" | ApiKey.id
  scopeName String // name when written, so the archive stays readable after a project is renamed or removed
  kind      String // "harian" | "mingguan" | "bulanan"
  start     String // first data day YYYY-MM-DD, Asia/Jakarta
  day       String // last data day YYYY-MM-DD, Asia/Jakarta
  data      Json // ReportData (lib/report.ts)
  cover     Json // ReportCover (lib/report.ts)
  createdAt DateTime @default(now())

  @@unique([scope, kind, start])
  @@index([scope, kind, day])
}

// Who an executive report is written for, per scope ("bank" or an API key id): the reader's position and name, the
// institution whose decisions the report serves ("lensa"), its region, coordination partners and the classification.
// Read when a report is written and copied into it, so the archive keeps what was printed at the time.
model ReportProfile {
  scope          String   @id // "bank" | ApiKey.id
  recipientTitle String   @default("") // "Kapolda Riau"
  recipientName  String   @default("") // "Irjen Pol Dr. …"
  institution    String   @default("") // "Polda Riau": the institution the analysis is written for
  region         String   @default("") // "Provinsi Riau"
  partners       String[] @default([]) // "Plt. Gubernur", "Kajati", …
  sifat          String   @default("RAHASIA / TERBATAS")
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}
