generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  prefix     String
  hash       String    @unique
  keyEnc     String? // the full key, AES-256-GCM (lib/server/secrets.ts), so admins can copy it later; null for keys made before this
  keywords   String[]  @default([]) // empty = whole bank; else items must mention one
  scope      Json      @default("{}") // other fixed restrictions, see lib/media/keyScope.ts
  createdBy  String? // admin username; null for keys made before this was recorded
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  classifier      Classifier?
  classifications Classification[]
}

// AI categorisation settings and progress for one API key.
model Classifier {
  apiKeyId        String    @id
  apiKey          ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  // The AI service this key uses, with its own credentials.
  providerKind    String // "anthropic" | "openai_compatible"
  providerBaseUrl String? // openai_compatible only, e.g. https://api.deepseek.com
  providerModel   String
  providerKeyEnc  String // AES-256-GCM, see lib/server/secrets.ts
  providerKeyHint String // last 4 characters, for display only
  enabled         Boolean   @default(true)
  prompt          String
  categories      Json // [{ code, label, description }]
  // Progress per media type: { social: { newest, oldest, done }, online: {...} } (ISO timestamps)
  cursors         Json      @default("{}")
  processed       Int       @default(0)
  failed          Int       @default(0)
  todayCount      Int       @default(0)
  todayDate       String    @default("")
  lastError       String?
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// One item's category for one API key.
model Classification {
  apiKeyId    String
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  type        String // "social" | "online"
  code        String // item code in the source database
  category    String // a category code, or "none"
  confidence  Float?
  reason      String?
  publishedAt DateTime
  model       String
  createdAt   DateTime @default(now())

  @@id([apiKeyId, type, code])
  @@index([apiKeyId, type, category, publishedAt])
}
