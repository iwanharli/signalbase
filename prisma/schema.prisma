generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Panel account. role "admin" manages everything; role "user" (a client) signs up, waits for an admin to approve,
// then uses the projects an admin gives it (ProjectMember).
model Account {
  id              String          @id @default(uuid())
  username        String          @unique
  name            String
  passwordHash    String
  role            String          @default("admin") // "admin" | "user"
  status          String          @default("active") // "pending" (signed up, waiting for an admin) | "active" | "suspended"
  /// Plan of a client ("user") account: "instansi" (the only plan offered). Unused for limits: clients have none.
  plan            String?
  /// End of the client's subscription; after it the client loses access to its projects and their API keys stop.
  /// null = no end date.
  planExpiresAt   DateTime?
  /// Sign-up details for the admin who approves: the institution and what it wants monitored.
  institution     String?
  requestedTopics String?
  invoices        Invoice[]
  /// Projects an admin gave this client (with one API key per client and project).
  sharedProjects  ProjectMember[]
  createdAt       DateTime        @default(now())
}

// A monitored project: its keywords and fixed scope, and its own API key (hash/keyEnc) for the public API.
model Project {
  id                  String    @id @default(uuid())
  name                String
  prefix              String
  hash                String    @unique
  keyEnc              String? // the full key, AES-256-GCM (lib/server/secrets.ts), so admins can copy it later; null for keys made before this
  keywords            String[]  @default([]) // empty = whole bank; else items must mention one
  scope               Json      @default("{}") // other fixed restrictions, see lib/media/keyScope.ts
  createdBy           String? // admin username; null for keys made before this was recorded
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime?
  revokedAt           DateTime?
  allowedIps          String[]  @default([]) // empty = any IP; else "1.2.3.4", "1.2.3.0/24" or IPv6 (lib/keyAccess.ts)
  allowedOrigins      String[]  @default([]) // empty = any site; else "app.example.id" or "*.example.id" (browser calls)
  /// Media pages: show the "Label emosi" (analysed or not) filter in the filter drawer for this project. Off: the drawer hides it.
  showAnalyzedFilter  Boolean   @default(false)
  /// Media pages: show the "Relevansi" filter in the filter drawer for this project. Off: hidden (default still hides irrelevant posts).
  showRelevanceFilter Boolean   @default(false)
  /// Keyword groups (keyword → group name, lib/media/keywordGroups.ts): to read and count the list by theme. Not part of
  /// the scope, so regrouping changes no data and no AI labels.
  keywordGroups       Json      @default("{}")

  classifier      Classifier?
  classifications Classification[]
  usage           ProjectUsage[]
  balances        BalanceSnapshot[]
  tokenUsage      TokenUsage[]
  members         ProjectMember[]
  /// Manual label choices of this project (in order), set by its owner or an admin; people label posts with one of them.
  manualLabels    String[]            @default([])
  itemLabels      ItemLabel[]
  labelAi         LabelAi?
  labelAiItems    LabelAiItem[]
  labelAiUsage    LabelAiUsage[]
  matches         ProjectMatch[]
  matchStates     ProjectMatchState[]
}

// AI categorisation settings and progress for one project.
model Classifier {
  projectId        String    @id
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // The AI service this project uses, with its own credentials.
  providerKind     String // "anthropic" | "openai_compatible"
  providerBaseUrl  String? // openai_compatible only, e.g. https://api.deepseek.com
  providerModel    String
  providerKeyEnc   String // AES-256-GCM, see lib/server/secrets.ts
  providerKeyHint  String // last 4 characters, for display only
  // Optional fallback, used for a batch only when the main provider fails (5xx, empty reply, timeout).
  fallbackKind     String?
  fallbackBaseUrl  String?
  fallbackModel    String?
  fallbackKeyEnc   String?
  fallbackKeyHint  String?
  enabled          Boolean   @default(true)
  prompt           String
  categories       Json // [{ code, label, description }]
  onlineCategories Json? // online news' own categories; null = same as `categories`
  minBalance       Float?    @default(1) // pause when provider credit drops below this; null = no floor
  dailyBudget      Float? // pause once today's spend reaches this; null = no cap
  // Item counts for the project's whole scope ({ social, online, at }); counting takes ~25 s, so it is kept here.
  scopeCounts      Json?
  labelledOnly     Boolean   @default(false) // API returns only items the AI has labelled
  startFrom        DateTime? // oldest publish time to label; null = the whole scope. Newer items are always labelled.
  // Progress per media type: { social: { newest, oldest, done }, online: {...} } (ISO timestamps)
  cursors          Json      @default("{}")
  processed        Int       @default(0)
  failed           Int       @default(0)
  todayCount       Int       @default(0)
  todayDate        String    @default("")
  lastError        String?
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// One item's category for one project.
model Classification {
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String // "social" | "online"
  code        String // item code in the source database
  category    String // a category code, or "none"
  confidence  Float?
  reason      String?
  publishedAt DateTime
  model       String
  manual      Boolean  @default(false) // set by an admin; the worker never overwrites it
  correctedBy String?
  createdAt   DateTime @default(now())

  @@id([projectId, type, code])
  @@index([projectId, type, category, publishedAt])
}

// Provider credit over time, recorded by the worker and on manual refresh; spend = drops between snapshots.
model BalanceSnapshot {
  id        Int      @id @default(autoincrement())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currency  String
  total     Float
  at        DateTime @default(now())

  @@index([projectId, at])
}

// Tokens the AI provider billed per project, hour, and model; works for every provider (no balance API needed).
model TokenUsage {
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hour         DateTime // start of the hour (UTC)
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  calls        Int      @default(0)
  keyHint      String? // last 4 characters of the paying provider key (since 16 Nov 2026); null = before it was recorded

  @@id([projectId, hour, model])
}

// Public API calls per project per day (Jakarta date), through the project's own key.
model ProjectUsage {
  projectId String
  day       String // YYYY-MM-DD, Asia/Jakarta
  count     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, day])
  @@index([day])
}

// Sales enquiries from the public /kontak page (e.g. the Instansi plan's "Hubungi kami").
model ContactRequest {
  id           String   @id @default(uuid())
  name         String
  organization String
  email        String
  phone        String?
  plan         String? // plan the visitor came from, e.g. "instansi"
  message      String
  handled      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([handled, createdAt])
}

// Manual billing: an invoice for one plan period. Marking it paid sets the account's plan and end date.
model Invoice {
  id          String    @id @default(uuid())
  number      String    @unique // SB-2026-0001
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind        String    @default("plan") // plan | topup (extra Signalbase AI posts for one month)
  plan        String // starter | pro | instansi (for a top-up: the plan it was bought on)
  billing     String // monthly | yearly (top-up: monthly)
  topupPosts  Int? // top-up only: posts added to that month's Signalbase AI quota
  subtotal    Int // rupiah, before tax
  tax         Int // rupiah
  total       Int
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("unpaid") // unpaid | paid | cancelled
  dueAt       DateTime
  paidAt      DateTime?
  note        String?
  createdBy   String // username of whoever created it (the user or an admin)
  createdAt   DateTime  @default(now())

  @@index([accountId, createdAt])
  @@index([status, createdAt])
}

// Platform AI settings (one row, id "global"): the provider behind Ringkasan AI, its schedule, and token prices for cost tracking.
model AiSetting {
  id               String   @id @default("global")
  providerKind     String   @default("openai_compatible") // "anthropic" | "openai_compatible"
  providerBaseUrl  String?
  providerModel    String
  providerKeyEnc   String // AES-256-GCM, see lib/server/secrets.ts
  providerKeyHint  String // last 4 characters, for display only
  summaryEnabled   Boolean  @default(true)
  summaryHour      Int      @default(6) // Jakarta hour the daily summaries are written
  includeProjects  Boolean  @default(true) // also one summary per active project, not only the whole bank
  monthlyBudget    Float? // stop writing summaries once this month's cost reaches this; null = no cap
  // Prices per 1M tokens, used to estimate each call's cost.
  priceInput       Float    @default(0.3)
  priceCachedInput Float    @default(0.006)
  priceOutput      Float    @default(1.2)
  currency         String   @default("USD")
  updatedBy        String?
  updatedAt        DateTime @updatedAt
}

// One AI summary of one scope ("bank" or a project id) for one complete Jakarta data day (written the morning after).
model AiSummary {
  id        String   @id @default(uuid())
  scope     String // "bank" | Project.id
  scopeName String // name when written, so history stays readable after a project is removed
  day       String // data day YYYY-MM-DD, Asia/Jakarta (normally yesterday when written)
  status    String // "ok" | "failed"
  content   Json? // SummaryContent (lib/ai/summary.ts)
  error     String?
  model     String
  attempts  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, day])
  @@index([day])
}

// Every call to the platform AI provider, with tokens and estimated cost: the cost history on the AI settings page.
model AiUsageLog {
  id           Int      @id @default(autoincrement())
  at           DateTime @default(now())
  purpose      String // "summary" | "report" | "test" | "isu"
  scope        String?
  scopeName    String?
  model        String
  inputTokens  Int      @default(0)
  cachedTokens Int      @default(0) // part of inputTokens served from the provider's cache
  outputTokens Int      @default(0)
  cost         Float    @default(0)
  currency     String
  ok           Boolean
  error        String?
  ms           Int      @default(0)

  @@index([at])
}

// Executive report snapshot of one scope ("bank" or a project id) for one complete period, written by the worker once the
// period is over: harian (one Jakarta day), mingguan (Monday-Sunday) or bulanan (a calendar month). `data` is the ReportData
// the print page renders; `cover` holds the few numbers the archive cards show.
model ArchivedReport {
  id        String   @id @default(uuid())
  scope     String // "bank" | Project.id
  scopeName String // name when written, so the archive stays readable after a project is renamed or removed
  kind      String // "harian" | "mingguan" | "bulanan"
  start     String // first data day YYYY-MM-DD, Asia/Jakarta
  day       String // last data day YYYY-MM-DD, Asia/Jakarta
  data      Json // ReportData (lib/report.ts)
  cover     Json // ReportCover (lib/report.ts)
  createdAt DateTime @default(now())

  @@unique([scope, kind, start])
  @@index([scope, kind, day])
}

// Who an executive report is written for, per scope ("bank" or a project id): the reader's position and name, the
// institution whose decisions the report serves ("lensa"), its region, coordination partners and the classification.
// Read when a report is written and copied into it, so the archive keeps what was printed at the time.
model ReportProfile {
  scope          String   @id // "bank" | Project.id
  recipientTitle String   @default("") // "Kapolda Riau"
  recipientName  String   @default("") // "Irjen Pol Dr. …"
  institution    String   @default("") // "Polda Riau": the institution the analysis is written for
  region         String   @default("") // "Provinsi Riau"
  partners       String[] @default([]) // "Plt. Gubernur", "Kajati", …
  sifat          String   @default("RAHASIA / TERBATAS")
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

/// A sub-account's access to one of its parent's projects, chosen by an admin. Members see the project and its data
/// (media, insights, issues, reports) but cannot change, revoke or copy it; plan limits and quotas stay with the owner.
/// A client's access to a project, given by an admin: the client sees the project's data (read only) and the project
/// answers the public API through this client's own key, which only admins see. The key stops with the client's
/// subscription or when an admin revokes it; the project's own key (Project.hash) stays the internal/admin key.
model ProjectMember {
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  createdBy     String?
  keyPrefix     String?
  keyHash       String? // SHA-256 of the key; looked up through the index (a random 32-byte key never repeats)
  keyEnc        String? // the full key, AES-256-GCM (lib/server/secrets.ts), so admins can copy it again
  keyCreatedAt  DateTime?
  keyLastUsedAt DateTime?
  keyRevokedAt  DateTime?

  @@id([projectId, accountId])
  @@index([accountId])
  @@index([keyHash])
}

/// AI labelling settings of one project ("Kustomisasi Label"), with its own provider key.
model LabelAi {
  projectId   String    @id
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider    String // "deepseek" | "grok"; the address follows from it, see lib/ai/labelAi.ts
  model       String
  keyEnc      String // AES-256-GCM, see lib/server/secrets.ts
  keyHint     String // last 4 characters, for display only
  prompt      String? // null = the default built from the project's labels
  startFrom   DateTime? // oldest publish time to label; null = the whole scope
  updatedBy   String
  savedAt     DateTime  @default(now()) // last save by a person (updatedAt also moves with the worker)
  enabled     Boolean   @default(false)
  // Worker state. Cursors per media type: { social: { newest, oldest, backfillDone, ... } }
  cursors     Json      @default("{}")
  processed   Int       @default(0)
  failed      Int       @default(0)
  todayCount  Int       @default(0)
  todayDate   String    @default("")
  errorStreak Int       @default(0)
  retryAfter  DateTime?
  lastError   String?
  lastRunAt   DateTime?
  /// Posts in the labelling range, cached because counting the source is slow.
  scopeCounts Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// What AI labelling has done with each post of a project, or that a person decided it.
model LabelAiItem {
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String // "social" | "online"
  code        String
  status      String // "done" | "empty" (no label fits) | "failed" | "waiting_text" | "human" (AI leaves it alone)
  attempts    Int       @default(0)
  retryAfter  DateTime?
  error       String?
  model       String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Normalised text fingerprint (lib/ai/labelSkip textKey): a later copy of the same text takes this post's result.
  textKey String?

  @@id([projectId, type, code])
  @@index([projectId, type, textKey])
  @@index([projectId, type, status, retryAfter])
}

/// Tokens of AI labelling per hour and model, kept apart from categorisation's.
model LabelAiUsage {
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hour              DateTime
  model             String
  inputTokens       Int      @default(0)
  cachedTokens      Int      @default(0)
  outputTokens      Int      @default(0)
  calls             Int      @default(0)
  // The source check's share of the tokens above (0 for rows from before it was kept apart), and its billable searches.
  checkInputTokens  Int      @default(0)
  checkCachedTokens Int      @default(0)
  checkOutputTokens Int      @default(0)
  searches          Int      @default(0)

  @@id([projectId, hour, model])
}

/// One label of one post or article within one project; an item can carry several (one row each).
model ItemLabel {
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type           String // "social" | "online"
  code           String
  label          String
  setBy          String // username
  source         String   @default("human") // "human" | "ai"
  /// AI confidence 0-100; null for a label a person gave.
  score          Int?
  additionalData Json?    @map("additional_data")
  /// Rows older than this column carry the time it was added, not when the label was given.
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt

  @@id([projectId, type, code, label])
  @@index([projectId, label])
}

/// One image analysed by the local media worker (npm run media): news images, X photos/video thumbnails and YouTube
/// thumbnails. Only the URL and the results are kept; the file itself is downloaded, analysed and discarded. One image
/// used by many posts (syndicated news photos) is analysed once (MediaLink holds where it appears).
model MediaAsset {
  id               String      @id @default(uuid())
  urlHash          String      @unique // sha256 of url
  url              String
  kind             String // "news" | "x_photo" | "x_video" | "youtube" | "instagram" | "threads"
  status           String      @default("pending") // "pending" | "done" | "failed" (retried) | "gone" (404/expired, not retried)
  error            String?
  attempts         Int         @default(0)
  /// After a failure, not retried before this (5 min, 30 min, 2 h), so a passing outage doesn't use up the attempts.
  nextAttemptAt    DateTime?
  /// A news outlet's default picture (the same image on ≥5 of its articles): hidden from the media page.
  placeholder      Boolean     @default(false)
  /// Images whose dHash differs by ≤ NEAR_TWIN_BITS share a group (the id of its first image): the same picture
  /// re-encoded, resized or with a small overlay, shared under different URLs. Set by the worker after analysis.
  twinGroup        String?
  width            Int?
  height           Int?
  dhash            String? // 64-bit difference hash (hex): the same picture re-encoded or resized gets the same or a close hash
  ocrText          String? // text read from the image ("" = none), outlet watermarks removed
  ocrWords         Int         @default(0)
  /// OCR lines with size and position ([{ t, h, cy }], relative to the image height), for keyText.
  ocrLines         Json?
  /// Text was found but couldn't be read (mostly low-confidence lines): usually non-Latin script (Arabic, Cyrillic, Chinese).
  unreadText       Boolean     @default(false)
  /// "Teks penting": ocrText without app chrome (likes, "Lihat N balasan", times, handles), camera stamps, small background
  /// text and lines already in the post's caption. Used by the cards, the "Ada teks" filter and the search.
  keyText          String?
  keyWords         Int         @default(0)
  /// Derived from keyText (src/lib/mediaVisual.ts), recomputed when TEXT_RULES_VERSION changes:
  /// a call to action (action word + date/time/place), the narrative key (same message on different pictures), and
  /// lines with numeric claims to check.
  actionCall       Json?
  narrative        String?
  claims           String[]
  textRules        Int         @default(0)
  /// Caption/title of the first item using the image (≤1000 chars), to drop OCR text that only repeats it.
  context          String?
  tags             Json? // [{ tag, score }] best visual tags (CLIP, zero-shot)
  tagList          String[] // the tag codes, for filtering
  sensitive        String[] // tags that mark possibly sensitive content (shown as "perlu ditinjau")
  model            String?
  analyzedAt       DateTime?
  /// The video this image is the poster of (X video, Instagram Reel): its speech is transcribed (scripts/media/asr_service.py).
  videoUrl         String?
  /// null = no video; "pending" | "done" | "failed" | "none" (no audio track, or too old when its turn came)
  transcriptStatus String?
  /// What was said in the first MEDIA_ASR_MAX_SECONDS of the video ("" = no speech), and the detected language.
  transcript       String?
  transcriptLang   String?
  transcriptAt     DateTime?
  createdAt        DateTime    @default(now())
  links            MediaLink[]

  @@index([transcriptStatus, createdAt])
  @@index([status, createdAt])
  @@index([dhash])
  @@index([twinGroup])
  @@index([narrative])
  @@index([analyzedAt])
}

/// Where an analysed image appears: one row per (item, position). publishedAt/source copy the item's, so the media page
/// can list and filter without the source database.
model MediaLink {
  type        String // "social" | "online"
  code        String // post_code / news_code in the source database
  position    Int
  assetId     String
  asset       MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  source      String // platform (twitter, youtube) or outlet
  publishedAt DateTime
  /// Projects (Project ids) whose scope includes this item, set by the worker when the item is collected and
  /// backfilled when a project is created or its scope changes (MediaProjectSync). The media page filters on it.
  keys        String[]   @default([])
  /// Projects that match this item only through the text in its image (not its caption). The source-database
  /// queries of those projects include these items too (bank/query.ts scopeConditions, imageCodes).
  imageKeys   String[]   @default([])

  @@id([type, code, position])
  @@index([assetId])
  @@index([publishedAt])
  @@index([keys], type: Gin)
  @@index([imageKeys], type: Gin)
}

/// Backfill of MediaLink.keys per project: `signature` is a hash of the scope it was computed for; a different one
/// (new project, keywords changed) restarts it. The cursor walks the links from newest to oldest.
model MediaProjectSync {
  keyId      String   @id
  signature  String
  cursorAt   String? // MediaLink."publishedAt" as text (to_char), compared as ::timestamp: a Date round-trip shifts it by the session time zone
  cursorCode String?
  done       Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

/// Progress of the media worker per feed ("news", "x", "youtube"): the newest item already collected. `ts` is the source
/// timestamp as text (WIB, no zone), exactly as compared in the source database.
model MediaCursor {
  name      String   @id
  ts        String
  code      String
  updatedAt DateTime @updatedAt
}

/// Health of the media worker (one row, id "main"), written every tick and shown to admins on the media page.
model MediaWorkerState {
  id          String   @id
  heartbeatAt DateTime
  serviceOk   Boolean
  lastError   String?
  lastTick    Json? // { collected, backfilled, analyzed, ms }
}

/// An issue found by clustering a project's social posts of the last days (worker `isu`, service `signalbase-klaster`).
/// Rewritten every run; a cluster that carries on keeps its id (and its AI title) when most of its posts are the same.
model IssueCluster {
  id        String   @id @default(uuid())
  projectId String
  active    Boolean  @default(true) // false: not found in the latest run (kept for its history, hidden)
  codes     String[] // member post codes (newest first, capped)
  posts     Int
  authors   Int
  negShare  Float // share of labelled posts that are "menolak" or "marah"
  growth    Float // posts per day in the last 2 days over the days before
  score     Float // early-warning score 0-100, for ordering
  keywords  String[]
  perDay    Json // { "YYYY-MM-DD": n }
  moods     Json // [[emotion, n], ...]
  samples   Json // [{ code, text, author, url, ts }], the clearest examples first
  title     String?
  summary   String?
  actors    String[] @default([])
  targets   String[] @default([])
  titledAt  Int      @default(0) // posts when the AI title was written; rewritten when the cluster has doubled
  firstSeen DateTime
  lastSeen  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, active, score])
}

/// An ad hoc SNA watch ("pantauan"): a named set of keywords, e.g. "Listyo makar" = listyo, makar, sadap. Within a
/// project (projectId) it reads that project's posts that also match one of its keywords; without (admins) the whole bank.
model SnaWatch {
  id        String   @id @default(uuid())
  projectId String? // null = whole bank (admins only)
  name      String
  keywords  String[] // same rules as project keywords: words, phrases or AND / OR expressions; any one matches
  createdBy String // username
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// Public API calls per client key and day (the project total stays in ProjectUsage).
model ProjectAccessUsage {
  projectId String
  accountId String
  day       String // YYYY-MM-DD, Jakarta
  count     Int    @default(0)

  @@id([projectId, accountId, day])
}

/// Items of the source database that match a project's keywords, for projects with a long keyword list (≥ MANY_KEYWORDS):
/// one search over hundreds of phrases takes minutes, so lib/server/projectMatches.ts matches new items every minute and
/// the older ones once (back to ProjectMatchState.coverFrom), and the project's queries read these codes instead.
/// Keyword match only: the project's other restrictions are still applied by the query.
model ProjectMatch {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // "social" | "online"
  code      String // post_code / news_code in the source database
  /// The item's timestamp as the source stores it (local time, no zone), kept as is.
  at        DateTime

  @@id([projectId, type, code])
  @@index([projectId, type, at])
}

/// Progress of ProjectMatch per project and media type. Ids are the source table's `id` (insert order).
model ProjectMatchState {
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         String
  /// The keywords the matches were made with (sha1 of the full-text query); different = start over.
  keywordsHash String
  /// Every item at or after this time is matched once `ready` (the backfill reached floorId).
  coverFrom    DateTime
  /// Forward cursor: items with an id up to here are matched.
  highId       BigInt
  /// Backfill cursor, going down to floorId.
  lowId        BigInt
  floorId      BigInt
  ready        Boolean  @default(false)
  /// Before `ready`: every item from this day on is matched already (the backfill walks back from the newest items), so
  /// recent ranges use the stored matches while the backfill goes on.
  readyFrom    DateTime?
  updatedAt    DateTime @updatedAt

  @@id([projectId, type])
}
