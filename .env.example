# Copy to .env and fill in. Never commit .env.

# Signalbase's own database (admins and API keys)
DATABASE_URL="postgresql://user@localhost:5432/signalbase"

# Read-only source: social media posts and online news (bankkomen)
BANKKOMEN_DATABASE_URL="postgresql://readonly_user:password@host:5432/bankkomen"

# Session signing key, 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# First admin, created by `npm run db:seed` only when no admin exists yet
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
